{
  "name": "ki-konzept-werkstatt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src scripts && prettier --check \"src/**/*.{ts,tsx}\" \"content/**/*.{ts,json}\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"content/**/*.{ts,json}\" \"scripts/**/*.ts\"",
    "validate:content": "tsx scripts/validate-content.ts",
    "deploy": "npm run build && echo 'Deployment läuft über GitHub Action (.github/workflows/deploy.yml) beim Push auf main.'"
  },
  "dependencies": {
    "docx": "^9.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
